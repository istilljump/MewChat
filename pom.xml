<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 版本选型说明：
        不用"本地已缓存"的 3.4.0，而是用 3.5.13 —— 因为 LangChain4j 1.20.0-beta30
        的 starter 就是针对 Spring Boot 3.5.13 编译的（其 POM 中 spring-boot-starter
        依赖版本为 3.5.13）。跨 3.4/3.5 使用可能出现自动配置类找不到的情况，故对齐。
        3.5.x 仍是 Spring Boot 3.x，满足需求。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.mewchat</groupId>
    <artifactId>mewchat</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>MewChat</name>
    <description>电商 AI 智能客服系统</description>

    <properties>
        <!-- 本机同时装有 JDK 17 与 JDK 22，编译目标锁定 LTS 17 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Boot 3 专用 starter，不可用 mybatis-plus-boot-starter（那是 Boot 2 的） -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <!-- 与本机 MySQL 8.0.34 服务端匹配 -->
        <mysql-connector.version>8.0.33</mysql-connector.version>

        <!--
            LangChain4j 采用"双版本号"策略，别被绕晕：
            - 核心模块（langchain4j、langchain4j-core）为纯版本号，此处由 starter 传递引入 1.20.0
            - 集成/接入模块（各 spring-boot-starter、milvus 等）带 -betaNN 后缀
            下面三个坐标都已确认存在于 Maven 仓库。
        -->
        <langchain4j.version>1.20.0-beta30</langchain4j.version>
        <!--
            由 langchain4j-milvus:1.20.0-beta30 传递引入，此处显式声明以求版本可见、可控。
            2.5.9 属于 Milvus 2.x SDK 线，对应 Milvus 2.5.x 服务端 —— 服务端版本请按此部署。
        -->
        <milvus-sdk.version>2.5.9</milvus-sdk.version>

        <!-- 依赖仲裁版本，见下方 dependencyManagement 的说明 -->
        <protobuf.version>3.25.5</protobuf.version>
        <errorprone.version>2.41.0</errorprone.version>
    </properties>

    <!--
        依赖版本仲裁：
        引入 milvus-sdk-java 后，protobuf-java 与 error_prone_annotations 出现了多路径版本分歧
        （gRPC 与 Milvus SDK 各自传递了不同版本）。这里显式钉死，让依赖树确定、可复现。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- milvus-sdk-java 传递引入；统一到最高版本，3.x 内部二进制兼容 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <!-- 避免低版本路径把 error_prone_annotations 降级到 2.20.0 -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${errorprone.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== Web / 接口层 ==================== -->
        <!-- 提供 MVC 与 SseEmitter，流式接口基于它实现，不引入 WebFlux 以免两套 Web 栈混用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== 安全 ==================== -->
        <!-- 引入后默认会拦截所有请求，已在 config.SecurityConfig 中放开，见该类注释 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ==================== 数据访问层 ==================== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--
            分页插件等依赖 JSqlParser 的 InnerInterceptor 在 MyBatis-Plus 3.5.9 起被拆到
            独立模块，不再随 starter 传递引入。缺了它 PaginationInnerInterceptor
            会直接编译不过。此模块带入 jsqlparser 5.0。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 大模型 / Agent ==================== -->
        <!-- 核心 starter：提供 @AiService、ChatMemory、Tool 等自动配置 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!--
            OpenAI 兼容协议接入。选它的原因：DeepSeek、通义千问(兼容模式)、智谱 GLM 等
            国内厂商都提供 OpenAI 兼容端点，改 base-url 即可切换，无需换依赖。
            后续确定具体厂商后，若需换专用 starter，只改这一处坐标即可。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- ==================== 向量库 ==================== -->
        <!-- LangChain4j 的 Milvus 集成，提供 MilvusEmbeddingStore（RAG 阶段使用） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- Milvus 官方 Java SDK，需求中明确要求直接引入 -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>${milvus-sdk.version}</version>
        </dependency>

        <!-- ==================== JSON ==================== -->
        <!-- 实际已由 spring-boot-starter-web 传递引入，此处显式声明以使依赖清单自解释 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            仅测试用。作用：在 MySQL 未启动的情况下也能完整加载 Spring 上下文，
            从而验证"项目能正常启动不报错"（见 MewChatApplicationTests）。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
